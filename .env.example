# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE: PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://cin_user:cin_secure_password@localhost:5432/college_isaac_newton_db?schema=public"

# AUTH: JWT secret key & expiration for user sessions
JWT_SECRET="cin-jwt-secret-replace-in-production-with-min-32-chars"
JWT_EXPIRES_IN="7d"

# STORAGE: Object storage for student admission documents & gallery
STORAGE_PROVIDER="cloudinary" # Options: cloudinary, firebase, gcs
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# NODE ENVIRONMENT
PORT=3000
NODE_ENV="development"

