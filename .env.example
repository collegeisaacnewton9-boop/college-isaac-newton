# ==============================================================================
# FICHIER D'EXEMPLE DE CONFIGURATION ENVIRONNEMENT (.env.example)
# AVERTISSEMENT DE SÉCURITÉ : Ne jamais enregistrer de véritables clés ou mots
# de passe dans ce fichier public. Copiez vers .env (qui est ignoré par Git).
# ==============================================================================

# Clé API Google Gemini (optionnel, pour fonctionnalités IA côté serveur)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL publique de l'application
APP_URL="https://collegeisaacnewton.com"

# Configuration SMTP pour les notifications e-mail institutionnelles (optionnel)
SMTP_USER="collegeisaacnewton9@gmail.com"
SMTP_PASS="votre_mot_de_passe_application_google"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465

# Synchronisation GitHub (Pôle Déploiement & Sauvegardes)
GITHUB_OWNER="collegeisaacnewton9-boop"
GITHUB_REPO="college-isaac-newton"
GITHUB_BRANCH="main"
GITHUB_PAT="votre_token_acces_personnel_github"

# Base de données PostgreSQL Cloud SQL (si configurée)
# DATABASE_URL="postgresql://user:password@localhost:5432/college_db"
